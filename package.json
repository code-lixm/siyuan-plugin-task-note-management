    "sass-loader": "^16.0.5",
    "siyuan": "1.1.8",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "vite": "^5.2.9",
    "vite-plugin-static-copy": "^1.0.2",
    "vite-plugin-zip-pack": "^1.0.5"
  },
